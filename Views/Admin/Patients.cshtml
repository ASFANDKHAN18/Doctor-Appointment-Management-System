@model List<hospitalMS.Models.Patient>

@{
    ViewBag.Title = "Patients";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-people"></i></span>

                <div>
                    <p class="eyebrow mb-1">Management</p>
                    <h1 class="h3 mb-1">Patients</h1>
                </div>
            </div>
        </div>

        <section class="panel mt-3">

            <div class="panel-header">

                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-table"></i>
                        <span>Patients</span>
                    </h2>

                    <p class="text-muted mb-0">
                        View all registered patients.
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-2">

                    <input class="form-control form-control-sm table-search"
                           type="search"
                           placeholder="Search Patient"
                           data-table-search="patientTable">

                </div>

            </div>

            <div class="table-responsive">

                <table class="table align-middle mb-0"
                       id="patientTable"
                       data-searchable-table>

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Gender</th>
                            <th>Age</th>
                            <th>Created At</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @item.Name
                                </td>

                                <td>
                                    @item.Phone
                                </td>

                                <td>
                                    @item.Gender
                                </td>

                                <td>
                                    @item.Age
                                </td>

                                <td>
                                    @(item.CreatedAt.HasValue
                                    ? item.CreatedAt.Value.ToString("dd MMM yyyy")
                                    : "-")
                                </td>
                                <td>
                                    <a href="@Url.Action("PatientDetails","Admin",new { id=item.Id })"
                                       class="btn btn-info btn-sm">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mt-3">
                <p class="text-muted small mb-0">Patients List</p>
            </div>

        </section>

    </div>
</main>