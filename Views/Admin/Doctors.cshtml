@model List<hospitalMS.Models.Doctor>

@{
    ViewBag.Title = "Doctors";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                @if (TempData["Success"] != null)
                {
                    <script>
        window.onload = function () {
            Swal.fire({ icon: 'success', title: 'Success', text: '@TempData["Success"]' });
        };
                    </script>
                }
                <div>
                    <p class="eyebrow mb-1">  Management</p>
                    <h1 class="h3 mb-1">
                        Doctors
                    </h1>

                </div>
            </div>
        </div>



        <section class="panel mt-3">
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title"><i class="bi bi-table" aria-hidden="true"></i><span>Doctors</span></h2>
                    <p class="text-muted mb-0">View and manage all doctors.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <input class="form-control form-control-sm table-search" type="search" placeholder="Search users" data-table-search="usersTable" aria-label="Search users">
                    <a class="btn btn-primary btn-sm" href="@Url.Action("AddDoctor","Admin")"><i class="bi bi-person-plus" aria-hidden="true"></i> Add User</a>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0" id="usersTable" data-searchable-table>
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Department</th>
                            <th>Specialization</th>
                            <th>Fee</th>
                            <th>Available Days</th>
                            <th>Available Time</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img class="avatar-img avatar-sm"
                                             src="@Url.Content(string.IsNullOrEmpty(item.Image)
                                                   ? "~/assets/images/doctors/default.png"
                                                      : item.Image)"
                                             alt="@item.Name" />

                                        <div>
                                            <p class="fw-semibold mb-0">@item.Name</p>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    @(item.Department != null ? item.Department.Name : "-")
                                </td>

                                <td>
                                    @item.Specialization
                                </td>

                                <td>
                                    Rs. @item.Fee
                                </td>

                                <td>
                                    @item.AvailableDays
                                </td>

                                <td>
                                    @item.AvailableTime
                                </td>

                                <td>

                                    @if (item.IsAvailable == true)
                                    {
                                        <span class="badge text-bg-success">
                                            Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">
                                            Not Available
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <a href="@Url.Action("EditDoctor","Admin", new { id = item.Id })"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    @if (item.IsAvailable == true)
                                    {
                                        <a href="@Url.Action("ToggleDoctorStatus","Admin",new { id=item.Id })"
                                           class="btn btn-warning btn-sm toggleDoctor">

                                            <i class="bi bi-pause-circle"></i>

                                            Deactivate

                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("ToggleDoctorStatus","Admin",new { id=item.Id })"
                                           class="btn btn-success btn-sm toggleDoctor">

                                            <i class="bi bi-check-circle"></i>

                                            Activate

                                        </a>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mt-3">
                <p class="text-muted small mb-0">Showing 1 to 5 of 124 users</p>
                <nav aria-label="Users pagination"><ul class="pagination pagination-sm mb-0"><li class="page-item disabled"><a class="page-link" href="#">Previous</a></li><li class="page-item active"><a class="page-link" href="#">1</a></li><li class="page-item"><a class="page-link" href="#">2</a></li><li class="page-item"><a class="page-link" href="#">Next</a></li></ul></nav>
            </div>
        </section>
    </div>
</main>

<script>

    document.querySelectorAll(".toggleDoctor").forEach(function (btn) {

        btn.addEventListener("click", function (e) {

            e.preventDefault();

            var url = this.href;

            Swal.fire({

                title: 'Change Doctor Status?',

                text: "Doctor availability will be updated.",

                icon: 'question',

                showCancelButton: true,

                confirmButtonText: 'Yes',

                cancelButtonText: 'Cancel'

            }).then((result) => {

                if (result.isConfirmed) {

                    window.location.href = url;

                }

            });

        });

    });

</script>