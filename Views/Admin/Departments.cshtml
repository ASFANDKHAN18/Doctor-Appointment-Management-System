@model List<hospitalMS.Models.Department>

@{
    ViewBag.Title = "Departments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-building" aria-hidden="true"></i></span>

                @if (TempData["Success"] != null)
                {
                    <script>
                        window.onload = function () {
                            Swal.fire({ icon: 'success', title: 'Success', text: '@TempData["Success"]' });
                        };
                    </script>
                }

                <div>
                    <p class="eyebrow mb-1">Management</p>
                    <h1 class="h3 mb-1">Departments</h1>
                </div>
            </div>
        </div>

        <section class="panel mt-3">
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-table"></i>
                        <span>Departments</span>
                    </h2>
                    <p class="text-muted mb-0">View and manage all departments.</p>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <input class="form-control form-control-sm table-search"
                           type="search"
                           placeholder="Search Department"
                           data-table-search="departmentTable">

                    <a class="btn btn-primary btn-sm"
                       href="@Url.Action("AddDepartment","Admin")">
                        <i class="bi bi-plus-circle"></i>
                        Add Department
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0"
                       id="departmentTable"
                       data-searchable-table>

                    <thead>
                        <tr>
                            <th>Department Name</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <p class="fw-semibold mb-0">@item.Name</p>
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge text-bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("dd MMM yyyy") : "-")
                                </td>

                                <td class="text-end">

                                    <a href="@Url.Action("EditDepartment","Admin",new { id=item.Id })"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    @if (item.IsActive)
                                    {
                                        <a href="@Url.Action("ToggleDepartmentStatus","Admin",new { id=item.Id })"
                                           class="btn btn-warning btn-sm toggleDepartment">
                                            <i class="bi bi-pause-circle"></i>
                                            Deactivate
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("ToggleDepartmentStatus","Admin",new { id=item.Id })"
                                           class="btn btn-success btn-sm toggleDepartment">
                                            <i class="bi bi-check-circle"></i>
                                            Activate
                                        </a>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            </div>

            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mt-3">
                <p class="text-muted small mb-0">Departments List</p>
            </div>

        </section>
    </div>
</main>

<script>
document.querySelectorAll(".toggleDepartment").forEach(function(btn){
    btn.addEventListener("click",function(e){
        e.preventDefault();

        var url=this.href;

        Swal.fire({
            title:'Are you sure?',
            text:'Department status will be changed.',
            icon:'warning',
            showCancelButton:true,
            confirmButtonText:'Yes'
        }).then((result)=>{
            if(result.isConfirmed){
                window.location.href=url;
            }
        });

    });
});
</script>