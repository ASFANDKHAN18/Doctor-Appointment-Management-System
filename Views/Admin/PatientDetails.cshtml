@model hospitalMS.Models.Patient

@{
    ViewBag.Title = "Patient Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-person"></i></span>
                <div>
                    <p class="eyebrow mb-1">Management</p>
                    <h1 class="h3 mb-1">Patient Details</h1>
                    <p class="text-muted mb-0">View patient information and appointment history.</p>
                </div>
            </div>
        </div>

        <section class="panel">

            <div class="panel-header">
                <h2 class="h5 mb-0 section-title">
                    <i class="bi bi-person-vcard"></i>
                    Patient Information
                </h2>
            </div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    <input class="form-control" value="@Model.Name" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Phone</label>
                    <input class="form-control" value="@Model.Phone" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Gender</label>
                    <input class="form-control" value="@Model.Gender" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Age</label>
                    <input class="form-control" value="@Model.Age" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Created At</label>
                    <input class="form-control"
                           value="@(Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToString("dd MMM yyyy") : "-")"
                           readonly />
                </div>

            </div>

        </section>

        <section class="panel mt-4">

            <div class="panel-header">
                <h2 class="h5 mb-0 section-title">
                    <i class="bi bi-calendar-check"></i>
                    Appointment History
                </h2>
            </div>

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Appointments.OrderByDescending(x => x.AppointmentDate))
                        {
                            <tr>

                                <td>@item.Doctor.Name</td>

                                <td>
                                    @(item.AppointmentDate.HasValue
                                    ? item.AppointmentDate.Value.ToString("dd MMM yyyy")
                                    : "-")
                                </td>

                                <td>
                                    @(item.AppointmentTime.HasValue
                                    ? DateTime.Today.Add(item.AppointmentTime.Value).ToString("hh:mm tt")
                                    : "-")
                                </td>

                                <td>

                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge text-bg-warning">Pending</span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge text-bg-primary">Approved</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge text-bg-success">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Cancelled</span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>

    </div>
</main>