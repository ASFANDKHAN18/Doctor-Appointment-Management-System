@model hospitalMS.Models.Department

@{
    ViewBag.Title = "Edit Department";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-pencil-square"></i></span>
                <div>
                    <p class="eyebrow mb-1">Management</p>
                    <h1 class="h3 mb-1">Edit Department</h1>
                    <p class="text-muted mb-0">Update department information.</p>
                </div>
            </div>
        </div>

        <section class="row g-3">
            <div class="col-12 col-xl-8">

                <form action="@Url.Action("EditDepartment","Admin")" method="post">

                    @Html.HiddenFor(x => x.Id)

                    <div class="panel">

                        <div class="panel-header">
                            <div>
                                <h2 class="h5 mb-1 section-title">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>Edit Department</span>
                                </h2>
                                <p class="text-muted mb-0">Update department details.</p>
                            </div>
                        </div>

                        <div class="row g-3">

                            <div class="col-12">
                                <label class="form-label">Department Name</label>

                                @Html.TextBoxFor(x => x.Name, new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter Department Name"
                                })

                                @Html.ValidationMessageFor(x => x.Name, "", new { @class = "text-danger" })
                            </div>

                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-check-circle"></i>
                                Update Department
                            </button>
                        </div>

                    </div>

                </form>

            </div>
        </section>

    </div>
</main>