
@{
    ViewBag.Title = "Success";
}

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="text-center shadow p-5">

                    <i class="icofont-check-circled text-success"
                       style="font-size:80px;"></i>

                    <h2 class="mt-4 mb-3 text-success">
                        Appointment Booked Successfully!
                    </h2>

                    <p class="mb-4">
                        Thank you for choosing our hospital.
                        Your appointment has been submitted successfully.
                        Our team will contact you shortly to confirm your appointment.
                    </p>

                    <a href="@Url.Action("Index","Home")"
                       class="btn btn-main btn-round-full mr-2">
                        Go Home
                    </a>

                    <a href="@Url.Action("Index","Doctor")"
                       class="btn btn-main-2 btn-round-full">
                        Back to Doctors
                    </a>

                </div>

            </div>
        </div>
    </div>
</section>