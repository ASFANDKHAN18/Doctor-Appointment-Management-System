@model List<hospitalMS.Models.Doctor>
@{
    ViewBag.Title = "Index";
}
<section class="page-title bg-1">
    <div class="overlay"></div>
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="block text-center">
                    <span class="text-white">All Doctors</span>
                    <h1 class="text-capitalize mb-5 text-lg">Specalized doctors</h1>

                 
                </div>
            </div>
        </div>
    </div>
</section>
<section class="section doctors">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center">
                <div class="section-title">
                    <h2>Doctors</h2>
                    <div class="divider mx-auto my-4"></div>
                    <p>We provide a wide range of creative services adipisicing elit. Autem maxime rem modi eaque, voluptate. Beatae officiis neque </p>
                </div>
            </div>
        </div>

        <div class="col-12 text-center mb-5">
            <div class="d-flex flex-wrap justify-content-center">

                <a href="@Url.Action("Index","Doctor")"
                   class="btn m-1 @(ViewBag.SelectedDepartment == null ? "btn-danger" : "btn-outline-dark")">
                    All Department
                </a>

                @foreach (var dept in ViewBag.Departments)
                {
                    <a href="@Url.Action("Index","Doctor", new { departmentId = dept.Id })"
                       class="btn m-1 @(ViewBag.SelectedDepartment == dept.Id ? "btn-danger" : "btn-outline-dark")">
                        @dept.Name
                    </a>
                }

            </div>
        </div>

        <div class="row shuffle-wrapper portfolio-gallery">
            @foreach (var item in Model)
            {
            <div class="col-lg-3 col-sm-6 col-md-6 mb-4 shuffle-item" data-groups="[&quot;cat1&quot;,&quot;cat2&quot;]">
                <div class="position-relative doctor-inner-box"  >
                    <div class="doctor-profile">
                        <div class="doctor-img">
                            <a href="/Doctor/DoctorDetail/@item.Id">
                             <img src="~/assets/images/team/1.jpg" alt="doctor-image" class="img-fluid w-100"></a>
                            
                        </div>
                    </div>
                    <div class="content mt-3">
                        <h4 class="mb-0"><a href="/Doctor/DoctorDetail/@item.Id">@item.Name</a></h4>
                        <p>@item.Department.Name </p>
                    </div>
                </div>
            </div>
            }

        </div>
    </div>
</section>
<section class="section cta-page">
    <div class="container">
        <div class="row">
            <div class="col-lg-7">
                <div class="cta-content">
                    <div class="divider mb-4"></div>
                    <h2 class="mb-5 text-lg">We are pleased to offer you the <span class="title-color">chance to have the healthy</span></h2>
                    <a href="@Url.Action("Index", "Doctor")" class="btn btn-main-2 btn-round-full">Get appoinment<i class="icofont-simple-right  ml-2"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>
